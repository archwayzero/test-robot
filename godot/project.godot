; Values equal to Godot defaults are kept on purpose (orientation, renderer, iOS driver): re-add them if an editor
; save drops them.

config_version=5

[application]

config/name="Test Robot"
run/main_scene="res://modules/game/internal/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

Core="*res://modules/core/public/core.gd"

[display]

window/handheld/orientation=0
window/size/viewport_width=1280
window/size/viewport_height=590
window/stretch/mode="canvas_items"
